// 1. FOR: jumlah putaran sudah pasti
FOR i ← 1 TO 3
    OUTPUT "for: i = ", i
ENDFOR

// 2. WHILE: kondisi dicek DULU, bisa 0 kali
n ← 3
WHILE n > 0
    OUTPUT "while: n = ", n
    n ← n - 1
ENDWHILE

// 3. DO-WHILE: badan jalan DULU, kondisi dicek di akhir
x ← 10
DO
    OUTPUT "do-while: x = ", x, " (tetap jalan sekali)"
    x ← x + 1
WHILE x < 5

// 4. FOR EACH: menelusuri isi array tanpa indeks
buah ← ["apel", "jeruk", "mangga"]
FOR EACH b IN buah
    OUTPUT "for-each: ", b
ENDFOR

// 5. bersarang: loop di dalam loop
FOR baris ← 1 TO 2
    isi ← ""
    FOR kolom ← 1 TO 3
        isi ← isi & (baris * kolom) & " "
    ENDFOR
    OUTPUT "nested: ", isi
ENDFOR

// 6. BREAK: keluar dari loop lebih awal
hasil ← ""
FOR i ← 1 TO 10
    IF i = 4 THEN BREAK
    hasil ← hasil & i & " "
ENDFOR
OUTPUT "break: ", hasil

// 7. CONTINUE: lewati sisa badan untuk putaran ini saja
hasil ← ""
FOR i ← 1 TO 6
    IF i MOD 2 = 0 THEN CONTINUE
    hasil ← hasil & i & " "
ENDFOR
OUTPUT "continue: ", hasil
