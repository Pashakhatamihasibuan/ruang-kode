{
 "aturan": [
  [
   "grid (row/col/gutter)",
   "class=\"[^\"]*(?<![\\w-])(row|col|col-[\\w-]+|row-cols-[\\w-]+|g-\\d|gx-\\d|gy-\\d|offset-[\\w-]+|order-[\\w-]+)(?![\\w-])",
   "^Sistem grid"
  ],
  [
   "utilitas flex & tampilan",
   "(?<![\\w-])(d-(sm-|md-|lg-|xl-)?(flex|none|block|inline-block|inline|grid|inline-flex)|justify-content-[\\w-]+|align-items-[\\w-]+|align-self-\\w+|flex-(row|column|wrap|fill|grow-\\d|shrink-\\d|md-row|lg-row|md-column)|gap-\\d)(?![\\w-])",
   "^Utilitas"
  ],
  [
   "warna & tipografi utilitas",
   "(?<![\\w-])(text-(primary|secondary|success|danger|warning|info|light|dark|white|body-secondary|body-tertiary|muted|bg-\\w+|\\w+-emphasis|uppercase|truncate)|bg-(primary|secondary|success|danger|warning|info|light|dark|white|body|body-tertiary|body-secondary|transparent|\\w+-subtle)|border-(primary|secondary|success|danger|warning|info|light|dark)|fw-\\w+|fs-\\d)(?![\\w-])",
   "^Utilitas"
  ],
  [
   "komponen tombol/kartu/alert/badge",
   "(?<![\\w-])(card|card-[\\w]+|alert|alert-[\\w]+|badge|btn-outline-\\w+|btn-sm|btn-lg|btn-close|spinner-[\\w-]+|stretched-link)(?![\\w-])",
   "^Tombol, kartu"
  ],
  [
   "navbar & collapse",
   "(?<![\\w-])(navbar|navbar-[\\w-]+|collapse|nav-link|nav-item)(?![\\w-])|data-bs-toggle=\"collapse\"",
   "^Navbar"
  ],
  [
   "form & validasi",
   "(?<![\\w-])(form-(control|select|check|check-input|check-label|label|text|floating|range|switch)|input-group|input-group-text|needs-validation|was-validated|is-valid|is-invalid|valid-feedback|invalid-feedback|has-validation)(?![\\w-])",
   "^Form dan validasi"
  ],
  [
   "JavaScript",
   "<script\\b(?![^>]*(ld\\+json|src=))|addEventListener|querySelector|getElementById|classList|=>|^\\s*(const|let|var)\\s|console\\.|\\bfunction\\b|\\son[a-z]+=",
   "^Form dan validasi"
  ],
  [
   "modal & API JS Bootstrap",
   "(?<![\\w-])modal(-[\\w-]+)?(?![\\w-])|new bootstrap\\.|bootstrap\\.\\w+\\.getOrCreateInstance|\\.bs\\.",
   "^Modal"
  ],
  [
   "variabel CSS --bs-, Sass, mode gelap",
   "--bs-|^\\s*\\$[a-z][\\w-]*\\s*:|@import\\s+\"bootstrap/scss|@use\\s|data-bs-theme|map-merge",
   "^Variabel CSS"
  ],
  [
   "dropdown, tab, accordion",
   "(?<![\\w-])(dropdown|dropdown-[\\w-]+|nav-tabs|nav-pills|tab-pane|tab-content|accordion|accordion-[\\w-]+)(?![\\w-])|data-bs-toggle=\"(tab|pill|dropdown)\"",
   "^Dropdown"
  ],
  [
   "offcanvas, toast, tooltip, popover",
   "(?<![\\w-])(offcanvas|offcanvas-[\\w-]+|toast|toast-[\\w-]+)(?![\\w-])|tooltip|popover",
   "^Offcanvas"
  ],
  [
   "tabel, list group, pagination",
   "class=\"[^\"]*(?<![\\w-])(table|table-[\\w-]+|list-group|list-group-[\\w-]+|pagination|pagination-\\w+|page-item|page-link)(?![\\w-])",
   "^Tabel, list group"
  ],
  [
   "stack, posisi, rasio",
   "(?<![\\w-])(hstack|vstack|position-(relative|absolute|fixed|sticky)|sticky-top|fixed-top|fixed-bottom|(top|bottom|start|end)-(0|50|100)|translate-middle(-[xy])?|ratio|ratio-\\w+|object-fit-\\w+)(?![\\w-])",
   "^Utilitas lanjutan"
  ],
  [
   "JSON-LD",
   "ld\\+json",
   "^\\b$"
  ]
 ],
 "abaikan": []
}
